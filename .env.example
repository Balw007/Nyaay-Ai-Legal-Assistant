# Nyaay settings. Copy this file to ".env" in the same folder. Lines starting with # are ignored.
# On your own Windows PC you can leave EVERYTHING below as it is: the defaults already use local AI.

# ============================== AI ==============================
# ollama    = AI runs on your own computer (free, private, nothing leaves it)
# anthropic = Claude API (needs ANTHROPIC_API_KEY; text is sent to Anthropic, client names are redacted first)
# none      = no AI: search and deadlines still work
NYAAI_LLM=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_MODEL_FAST=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Small computer (8 GB RAM)? Use the small model for everything:
# OLLAMA_MODEL=qwen3:4b
# Reads photos of orders with AI when Tesseract is not installed (ollama pull qwen2.5vl:7b):
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# ANTHROPIC_API_KEY=

# ============================== Scanned orders (OCR) ==============================
# Languages Tesseract should read. Missing language packs are skipped automatically.
NYAAI_OCR_LANG=eng+hin+mar
# Pages read below this confidence (percent) are flagged "check against the original".
# NYAAY_OCR_LOW_CONF=70
# Read scanned judgments in the big Supreme Court / High Court downloads too. Slow on a laptop, so off by default.
# Judgments you upload yourself are always read with OCR.
# NYAAY_OCR_BULK=1
# Windows only, if Tesseract is installed somewhere unusual:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ============================== Optional integrations ==============================
INDIANKANOON_TOKEN=
ECOURTSINDIA_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BRIEF_TEMPLATE=

# ============================== SERVER ONLY (docker compose, see DEPLOY.md) ==============================
# Ignore this section on your own PC.
# Your address, without https://  (example: nyaay.yourfirm.in). Point its DNS A record at the server first.
NYAAY_DOMAIN=
# A long random password for the database. Make one with:  openssl rand -base64 24
POSTGRES_PASSWORD=
# Where the server finds Ollama. The default is the optional "local-ai" container in docker-compose.yml.
# To use a separate computer for AI (for example one with a GPU), set its address here:
# OLLAMA_SERVER_URL=http://10.0.0.5:11434
